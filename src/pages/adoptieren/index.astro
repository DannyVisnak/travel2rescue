---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DogCard from '@/components/DogCard.astro';
import CTABand from '@/components/CTABand.astro';
import FAQItem from '@/components/FAQItem.astro';
import ContactForm from '@/components/ContactForm.astro';
import VermitteltStrip from '@/components/VermitteltStrip.astro';
import Lines from '@/components/Lines.astro';
import FaqSchema from '@/components/FaqSchema.astro';
import { heroLayout, heroOverlay, heroSubClass, imageFocusClass } from '@/lib/layout';
import { reader } from '@/lib/keystatic';
import { img } from '@/lib/img';

const dogEntries = await reader.collections.dogs.all();
const DOGS = dogEntries
  .filter(({ entry }) => entry.available)
  .map(({ slug, entry }) => ({ id: slug, ...entry }));
// Nur ein Ausschnitt — die komplette Übersicht lebt auf /adoptieren/hunde/.
// Profile mit Foto zuerst.
const TEASER_DOGS = [...DOGS]
  .sort((a, b) => Number(Boolean(b.image)) - Number(Boolean(a.image)))
  .slice(0, 6);

const a = await reader.singletons.adoptionContent.read();
const helpData = await reader.singletons.helpContent.read();

const heroEyebrow = a?.heroEyebrow || 'Adoption · 6–7 Monate';
const heroTitle = a?.heroTitle || 'Find deinen';
const heroTitleAccent = a?.heroTitleAccent || 'besten Freund fürs Leben.';
const heroSub = a?.heroSub || 'Jeder Hund verdient ein liebevolles Zuhause. Unsere Hunde haben Schlimmeres überlebt, als du dir vorstellen kannst – und jetzt sind sie bereit für ihr letztes, schönstes Kapitel.';
const heroImage = img(a?.heroImage, '/images/fynneileen dogs.jpeg');
const adoptHeroPosition = a?.heroTextPosition;
const adoptHero = heroLayout(adoptHeroPosition);
const adoptHeroImageClass = imageFocusClass(a?.heroImageFocus, '');
const adoptHeroOverlay = heroOverlay(adoptHeroPosition, 'from-black/85 to-black/40');

const commitmentEyebrow = a?.commitmentEyebrow || 'Was uns unterscheidet';
const commitmentText = a?.commitmentText || 'Eine Adoption aus Lombok dauert';
const commitmentAccent = a?.commitmentAccent || '6–7 Monate.';
const commitmentSub = a?.commitmentSub || 'Aber genau diese Zeit ist, was uns von Schnell-Vermittlungen unterscheidet — und was deinen Hund sicher zu dir bringt.';
const commitmentBadge = a?.commitmentBadge || 'Vorgeschrieben durch EU-Tollwut-Regulierung — und unsere Sorgfalt.';

const TIMELINE = a?.timeline?.length
  ? a.timeline
  : [
      { nummer: '01', title: 'Kennenlernen', duration: 'Wochen 1–2', desc: 'Bewerbung, Telefonat, gegenseitiges Kennenlernen.' },
      { nummer: '02', title: 'Vorbereitung', duration: 'Monate 1–4', desc: 'Tollwut-Impfung, Titer-Test, Wartezeit.' },
      { nummer: '03', title: 'Behördliches', duration: 'Monat 5–6', desc: 'Papiere, Tierarzt-Atteste, Flug-Buchung.' },
      { nummer: '04', title: 'Ankunft', duration: 'Monat 6–7', desc: 'Dein Hund kommt nach Deutschland.' },
    ];

const dogsEyebrow = a?.dogsEyebrow || 'Verfügbare Hunde';
const dogsHeadline = a?.dogsHeadline || 'Sie warten';
const dogsHeadlineAccent = a?.dogsHeadlineAccent || 'auf dich.';
const dogsSub = a?.dogsSub || 'Jeder dieser Hunde hat eine einzigartige Geschichte. Jeder wartet darauf, ein neues Kapitel mit dir zu beginnen.';

const benefitsEyebrow = a?.benefitsEyebrow || 'Was dich erwartet';
const benefitsHeadline = a?.benefitsHeadline || 'Ein gesundes Tier.';
const benefitsHeadlineAccent = a?.benefitsHeadlineAccent || 'Und eine echte Beziehung.';
const benefitsSub = a?.benefitsSub || 'Diese drei Dinge bekommst du von uns. Nicht versprochen — geliefert.';
const benefitsImage = img(a?.benefitsImage, '/images/IMG_9452.jpg');
const benefits = a?.benefits?.length
  ? a.benefits
  : [
      { title: 'Tierliebe und Fürsorge', desc: 'Unsere Hunde sind medizinisch versorgt, gechipt, geimpft und kastriert. Du bekommst ein gesundes Tier.' },
      { title: 'Nachhaltige Vermittlung', desc: 'Wir stellen sicher, dass Hund und Mensch wirklich zueinander passen. Keine Adoption auf Verdacht.' },
      { title: 'Begleitung durch den Prozess', desc: 'Wir sind von Anfang bis Ende an deiner Seite – auch nach der Ankunft in Deutschland.' },
    ];

const formEyebrow = a?.formEyebrow || 'Bereit?';
const formHeadline = a?.formHeadline || 'Stell deine';
const formHeadlineAccent = a?.formHeadlineAccent || 'Adoptionsanfrage.';
const formSub = a?.formSub || 'Schreib uns – und wir schauen gemeinsam, welcher Hund wirklich zu dir passt.';

const fallbackFaqs = [
  { question: 'Wie läuft der Adoptionsprozess ab?', answer: 'Du füllst unser Formular aus, dann führen wir einen Videocall durch. Wenn alles passt, folgen weitere Gespräche und dann beginnt die Ausreisevorbereitung deines Hundes nach Deutschland.' },
  { question: 'Welche Voraussetzungen muss ich erfüllen?', answer: 'Ein gesichertes Zuhause, Zeit und die Bereitschaft, 6–7 Monate auf deinen Hund zu warten. Keine Erfahrung mit Straßenhunden notwendig – wir begleiten dich durch alles.' },
  { question: 'Gibt es eine Adoptionsgebühr?', answer: 'Ja, eine Schutzgebühr, die die Ausreisekosten (Titer-Test, Tierarztuntersuchungen, Flug) deckt. Diese wird im Gespräch individuell abgestimmt.' },
  { question: 'Warum dauert die Adoption so lange?', answer: 'Aufgrund der Tollwut-Bestimmungen der EU dauert die Ausreisevorbereitung mindestens 6–7 Monate: Tollwutimpfung, Titer-Test, Wartezeit, Papiere. Das ist Pflicht – kein Bürokratismus.' },
  { question: 'Was passiert, wenn es nicht klappt?', answer: 'Kein Hund bleibt ohne Zuhause. Wir finden gemeinsam eine Lösung – sei es eine Pflegestelle, ein anderer Adoptant oder weitere Gespräche. Wir lassen niemanden fallen.' },
];
const faqs = helpData?.adoptionFaqs?.length ? helpData.adoptionFaqs : fallbackFaqs;
---

<BaseLayout
  title="Hund adoptieren"
  description="Gib einem geretteten Straßenhund aus Lombok ein Zuhause in Deutschland. Travel2Rescue e.V. begleitet dich durch den 6–7 monatigen Adoptionsprozess – vom Kennenlernen bis zur Ankunft."
>
  <!-- Hero -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src={heroImage} alt="Gerettete Hunde bei Travel2Rescue" class:list={['w-full h-full object-cover', adoptHeroImageClass]} width="1200" height="1800" fetchpriority="high" loading="eager" decoding="async" />
      <div class:list={['absolute inset-0', adoptHeroOverlay]} />
    </div>
    <div class:list={['container-x relative z-10 max-w-2xl', adoptHero.box]}>
      <p class="eyebrow mb-5">{heroEyebrow}</p>
      <h1 class="text-5xl md:text-6xl font-black mb-6">
        <Lines text={heroTitle} /><br />
        <span class="text-amber-500">{heroTitleAccent}</span>
      </h1>
      <p class:list={['text-xl text-white/70 leading-relaxed mb-8', heroSubClass(adoptHeroPosition)]}>
        {heroSub}
      </p>
      <div class:list={['flex flex-wrap gap-3', adoptHero.buttons]}>
        <a href="#hunde" class="btn-primary btn-large">Hunde entdecken</a>
        <a href="#prozess" class="btn-ghost btn-large">So lange dauert es</a>
      </div>
    </div>
  </section>

  <!-- 6–7 Monate Commitment Statement -->
  <!-- Verlauf: sehr dunkles Braun oben → helleres Braun unten -->
  <section id="prozess" class="relative py-24 bg-gradient-to-b from-[#140F0B] via-[#241A13] to-[#3A2C20] overflow-hidden">
    <div class="absolute inset-0 pointer-events-none opacity-[0.06]" style="background-image: radial-gradient(circle at 1px 1px, #E8D4BB 1px, transparent 0); background-size: 28px 28px;"></div>
    <div class="container-x relative">
      <div class="max-w-4xl mx-auto text-center">
        <p class="eyebrow mb-5">{commitmentEyebrow}</p>
        <p class="font-serif italic text-3xl md:text-4xl lg:text-5xl leading-[1.25] text-cream">
          {commitmentText}
          <span class="text-amber-500 not-italic font-display font-black tracking-tight">{commitmentAccent}</span>
          <br class="hidden md:block" />
          Wir wissen, das ist viel verlangt.
        </p>
        <p class="mt-6 font-serif italic text-xl md:text-2xl text-white/75 leading-relaxed max-w-2xl mx-auto">
          {commitmentSub}
        </p>

        <div class="mt-8 inline-flex items-center gap-3 px-5 py-2.5 rounded-full bg-amber-500/10 border border-amber-500/20">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-amber-400">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </svg>
          <span class="text-sm text-amber-400/90 font-medium tracking-wide">{commitmentBadge}</span>
        </div>
      </div>

      <!-- 4-step Timeline -->
      <div class="mt-16 lg:mt-20">
        <!-- horizontal connector line on desktop -->
        <div class="relative hidden lg:block">
          <div class="absolute left-[10%] right-[10%] top-7 h-px bg-gradient-to-r from-transparent via-amber-500/30 to-transparent" aria-hidden="true"></div>
          <ol class="relative grid grid-cols-4 gap-6">
            {TIMELINE.map((step) => (
              <li class="relative">
                <div class="flex flex-col items-center text-center">
                  <div class="w-14 h-14 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center backdrop-blur-sm">
                    <span class="font-serif italic text-xl text-cream">{step.nummer}</span>
                  </div>
                  <div class="mt-5 w-full rounded-2xl bg-[#231a14] border border-amber-500/10 p-5 shadow-[0_2px_0_rgba(0,0,0,0.4)]">
                    <p class="text-xs uppercase tracking-[0.15em] text-amber-500/80">{step.duration}</p>
                    <h3 class="mt-1 text-lg font-bold text-cream">{step.title}</h3>
                    <p class="mt-2 text-sm text-white/65 leading-relaxed">{step.desc}</p>
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <!-- vertical layout on mobile/tablet -->
        <ol class="lg:hidden relative space-y-5 max-w-xl mx-auto pl-4">
          <div class="absolute left-7 top-7 bottom-7 w-px bg-gradient-to-b from-amber-500/30 via-amber-500/15 to-transparent" aria-hidden="true"></div>
          {TIMELINE.map((step) => (
            <li class="relative flex gap-4">
              <div class="relative shrink-0">
                <div class="w-14 h-14 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center">
                  <span class="font-serif italic text-xl text-cream">{step.nummer}</span>
                </div>
              </div>
              <div class="flex-1 rounded-2xl bg-[#231a14] border border-amber-500/10 p-5">
                <p class="text-xs uppercase tracking-[0.15em] text-amber-500/80">{step.duration}</p>
                <h3 class="mt-1 text-lg font-bold text-cream">{step.title}</h3>
                <p class="mt-2 text-sm text-white/65 leading-relaxed">{step.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Hunde — beige Sektion, damit die dunklen Steckbrief-Karten hervorstechen -->
  <section id="hunde" class="py-20 bg-beige">
    <div class="container-x">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">{dogsEyebrow}</p>
        <h2 class="section-heading text-black"><Lines text={dogsHeadline} /><br /><span class="text-amber-500">{dogsHeadlineAccent}</span></h2>
        <p class="text-xl md:text-2xl text-black/70 max-w-2xl leading-relaxed mx-auto mt-4">
          {dogsSub}
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {TEASER_DOGS.map((dog) => (
          <DogCard dog={dog} />
        ))}
      </div>
      <div class="text-center">
        <a href="/adoptieren/hunde/" class="btn-primary btn-large">Alle {DOGS.length} Hunde ansehen</a>
      </div>
    </div>
  </section>

  <!-- Warum ein Straßenhund (asymmetric photo-bleed layout) -->
  <section class="relative py-0 bg-black overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 lg:min-h-[560px]">
      <!-- photo bleeds to the left edge -->
      <div class="relative lg:col-span-7 h-72 sm:h-96 lg:h-auto">
        <img src={benefitsImage} alt="Adoptierter Hund" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
        <div class="absolute inset-0 lg:bg-gradient-to-r from-transparent via-transparent to-black/40"></div>
        <div class="hidden lg:block absolute -right-px top-0 bottom-0 w-px bg-amber-500/10"></div>
        <span class="absolute left-6 bottom-6 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-sm border border-white/10 text-xs text-white/80 tracking-wide">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-400">
            <circle cx="11" cy="4" r="2" />
            <circle cx="18" cy="8" r="2" />
            <circle cx="20" cy="16" r="2" />
            <circle cx="4" cy="8" r="2" />
            <path d="M8 14a4 4 0 0 0-4 4 3 3 0 0 0 3 3 6 6 0 0 0 3-1 6 6 0 0 0 3 1 3 3 0 0 0 3-3 4 4 0 0 0-4-4 4 4 0 0 0-4 0Z" />
          </svg>
          Adoptiert · 2024
        </span>
      </div>

      <!-- copy on warm card -->
      <div class="lg:col-span-5 bg-[#1a1410] flex items-center">
        <div class="px-6 sm:px-10 lg:px-14 py-16 lg:py-24 max-w-xl">
          <p class="eyebrow mb-4">{benefitsEyebrow}</p>
          <h2 class="text-4xl md:text-5xl font-black mb-3 leading-tight">
            <Lines text={benefitsHeadline} /><br />
            <span class="text-amber-500 font-serif italic font-normal tracking-normal">{benefitsHeadlineAccent}</span>
          </h2>
          <p class="text-white/65 mb-8">{benefitsSub}</p>

          <div class="space-y-5">
            {benefits.map((item) => (
              <div class="flex gap-4">
                <div class="w-8 h-8 rounded-full bg-amber-500/10 border border-amber-500/20 flex items-center justify-center shrink-0 mt-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-amber-400">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-cream mb-1">{item.title}</h3>
                  <p class="text-white/60 text-sm leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-gray-dark">
    <div class="container-x max-w-3xl mx-auto">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">Häufige Fragen</p>
        <h2 class="section-heading">FAQ Adoption</h2>
      </div>
      {faqs.map((faq) => (
        <FAQItem question={faq.question} answer={faq.answer} />
      ))}
    </div>
  </section>

  <!-- Vermittelt strip — emotional closing beat -->
  <VermitteltStrip count={25} />

  <!-- Adoptionsanfrage -->
  <section class="py-20 bg-black">
    <div class="container-x max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <p class="eyebrow mb-3">{formEyebrow}</p>
        <h2 class="text-3xl font-black mb-4"><Lines text={formHeadline} /><br /><span class="text-amber-500">{formHeadlineAccent}</span></h2>
        <p class="text-white/60">{formSub}</p>
      </div>
      <ContactForm subject="Adoptionsanfrage" />
    </div>
  </section>

  <CTABand
    headline="Noch kein Hund, aber helfen?"
    sub="Spende rettet das Leben der Hunde, bis sie ihr Zuhause finden."
    primary={{ label: 'Jetzt spenden', href: '/helfen/' }}
    secondary={{ label: 'Volunteer werden', href: '/helfen/#volunteer' }}
  />

  <FaqSchema faqs={faqs} />
</BaseLayout>

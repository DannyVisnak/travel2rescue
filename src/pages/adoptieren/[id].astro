---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTABand from '@/components/CTABand.astro';
import { reader } from '@/lib/keystatic';
import { img } from '@/lib/img';
import { SITE } from '@/data/site';

// On-demand SSR (no prerender) so middleware can gate this page when
// SITE_PASSWORD is set. Astro looks up the slug via Astro.params.id at
// request time.
const cmsSettings = await reader.singletons.settings.read();
const paypalUrl = cmsSettings?.paypalUrl ?? SITE.social.paypal;

const { id } = Astro.params as { id: string };
const entry = id ? await reader.collections.dogs.read(id) : null;
if (!entry) {
  return Astro.redirect('/adoptieren/');
}

const dog = {
  id,
  name: entry.name,
  age: entry.age,
  breed: entry.breed,
  character: entry.character,
  story: entry.story,
  image: entry.image,
  available: entry.available,
  tag: entry.tag || undefined,
};
const dogImage = img(dog.image);

const metaDescription = `${dog.name} (${dog.age}, ${dog.breed}) sucht ein Zuhause in Deutschland. ${dog.story}`.slice(0, 155);

// Rich-results: Article-style schema for the dog adoption profile so Google
// can show name + photo + summary in search results. Animal isn't a standard
// rich-result type, so we use Article (the dog "profile" is the article).
const dogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${dog.name} – ${dog.breed} sucht ein Zuhause`,
  description: metaDescription,
  image: `${SITE.url}${dogImage}`,
  inLanguage: 'de-DE',
  author: { '@type': 'NGO', name: SITE.name, url: SITE.url },
  publisher: {
    '@type': 'NGO',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/og-image.png` },
  },
  mainEntityOfPage: `${SITE.url}/adoptieren/${dog.id}/`,
  about: {
    '@type': 'Thing',
    name: `${dog.name}, ${dog.age}, ${dog.breed}`,
  },
};
---

<BaseLayout
  title={`${dog.name} adoptieren`}
  description={metaDescription}
  ogImage={dogImage}
  ogType="article"
>
  <!-- Hero -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src={dogImage} alt={dog.name} class="w-full h-full object-cover" width="1200" height="900" fetchpriority="high" loading="eager" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-r from-black/85 to-black/30" />
    </div>
    <div class="container-x relative z-10 max-w-2xl">
      <a href="/adoptieren/" class="inline-flex items-center gap-2 text-white/50 hover:text-white text-sm mb-6 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Alle Hunde
      </a>
      {dog.tag && <p class="eyebrow mb-4">{dog.tag}</p>}
      <h1 class="text-5xl md:text-6xl font-black mb-4">{dog.name}</h1>
      <p class="text-lg text-white/70 mb-2">{dog.age} · {dog.breed}</p>
      <p class="text-amber-400 font-semibold mb-8">{dog.character}</p>
      <a href={`/adoptieren/formular/?hund=${dog.id}`} class="btn-primary btn-large">
        Adoptionsanfrage für {dog.name}
      </a>
    </div>
  </section>

  <!-- Story -->
  <section class="py-20 bg-black">
    <div class="container-x max-w-3xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <p class="eyebrow mb-4">Die Geschichte</p>
          <h2 class="text-3xl font-black mb-6">Wer ist <span class="text-amber-500">{dog.name}?</span></h2>
          <p class="text-white/70 leading-relaxed text-lg">{dog.story}</p>
          <div class="mt-8 space-y-3">
            <div class="flex items-center gap-3 text-sm">
              <span class="text-white/40 w-20 shrink-0">Alter</span>
              <span class="font-medium">{dog.age}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-white/40 w-20 shrink-0">Rasse</span>
              <span class="font-medium">{dog.breed}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-white/40 w-20 shrink-0">Charakter</span>
              <span class="font-medium text-amber-400">{dog.character}</span>
            </div>
            <div class="flex items-center gap-3 text-sm">
              <span class="text-white/40 w-20 shrink-0">Status</span>
              <span class="pill bg-amber-500/20 text-amber-400">{dog.tag ?? 'Verfügbar'}</span>
            </div>
          </div>
        </div>
        <div>
          <img
            src={dogImage}
            alt={dog.name}
            class="rounded-2xl w-full aspect-[3/4] object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Was du wissen solltest -->
  <section class="py-20 bg-gray-dark">
    <div class="container-x max-w-3xl">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">Wichtig zu wissen</p>
        <h2 class="text-3xl font-black">Was dich erwartet.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            icon: '⏳',
            title: '6–7 Monate Wartezeit',
            desc: 'EU-Tollwutbestimmungen erfordern Titer-Test, Impfung und Wartezeit. Das ist Pflicht – kein Bürokratismus.',
          },
          {
            icon: '💶',
            title: '1.500–2.000 € Reisekosten',
            desc: 'Diese Schutzgebühr deckt Flug, Titer-Test, Tierarzt und alle Ausreisepapiere.',
          },
          {
            icon: '🤝',
            title: 'Wir begleiten dich',
            desc: 'Von der ersten Anfrage bis zur Ankunft in Deutschland. Du bist nie allein mit dem Prozess.',
          },
        ].map((item) => (
          <div class="bg-gray-mid rounded-2xl p-6 border border-white/5">
            <div class="text-3xl mb-3">{item.icon}</div>
            <h3 class="font-bold mb-2">{item.title}</h3>
            <p class="text-white/60 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-black">
    <div class="container-x max-w-xl mx-auto text-center">
      <p class="eyebrow mb-4">Bereit für {dog.name}?</p>
      <h2 class="text-4xl font-black mb-4">Füll das Adoptionsformular aus.</h2>
      <p class="text-white/60 mb-8 leading-relaxed">
        Sobald du das Formular ausgefüllt hast, meldet sich Eileen per WhatsApp bei dir.
        Kein Tribunal – ein echtes Gespräch.
      </p>
      <a href={`/adoptieren/formular/?hund=${dog.id}`} class="btn-primary btn-large">
        Jetzt Formular ausfüllen
      </a>
    </div>
  </section>

  <CTABand
    headline="Noch kein Hund, aber helfen?"
    sub="Spende rettet das Leben der Hunde, bis sie ihr Zuhause finden."
    primary={{ label: 'Jetzt spenden', href: paypalUrl }}
    secondary={{ label: 'Alle Hunde ansehen', href: '/adoptieren/' }}
  />

  <script type="application/ld+json" set:html={JSON.stringify(dogJsonLd)} />
</BaseLayout>

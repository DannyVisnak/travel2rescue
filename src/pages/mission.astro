---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsBand from '@/components/StatsBand.astro';
import CTABand from '@/components/CTABand.astro';
import ContactForm from '@/components/ContactForm.astro';
---

<BaseLayout
  title="Unsere Mission"
  description="50.000 Straßenhunde leben auf Lombok, Indonesien. Travel2Rescue e.V. kämpft mit Kastration, Fütterung, medizinischer Versorgung und Rettungen gegen diesen Kreislauf aus Elend."
>
  <!-- Hero -->
  <section class="relative py-28 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/IMG_2977.jpg"
        alt="Straßenhund auf Lombok"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/75" />
    </div>
    <div class="container-x relative z-10 text-center max-w-3xl mx-auto">
      <p class="eyebrow mb-5">Unsere Mission</p>
      <h1 class="text-5xl md:text-7xl font-black leading-tight mb-6">
        Wir kämpfen für Hunde,<br />
        <span class="text-amber-500">die sonst niemand sieht.</span>
      </h1>
      <p class="text-xl text-white/70 leading-relaxed">
        Schätzungsweise 50.000 Straßenhunde leben auf Lombok. Viele von ihnen krank, hungrig, völlig auf sich allein gestellt. Unsere Mission: diesen Kreislauf aus Elend zu durchbrechen.
      </p>
    </div>
  </section>

  <!-- Stats -->
  <StatsBand />

  <!-- Das Problem -->
  <section class="py-20 bg-black">
    <div class="container-x">
      <div class="text-center mb-14">
        <p class="eyebrow mb-3">Das Problem</p>
        <h2 class="section-heading">Der tägliche<br /><span class="text-amber-500">Überlebenskampf.</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            title: 'Der ständige Hunger',
            img: '/images/IMG_2027.jpg',
            desc: 'Für die meisten Hunde auf Lombok gibt es niemanden, der hinsieht. Aus purer Verzweiflung fressen viele Steine, Müll oder Plastik – das führt zu inneren Verletzungen, Vergiftungen und oft einem qualvollen Tod.',
            solution: 'Tägliche Fütterungsrunden, sauberes Wasser, Aufklärung der Gemeinden über artgerechte Ernährung.',
          },
          {
            title: 'Gefahr auf der Straße',
            img: '/images/IMG_0891.jpg',
            desc: 'Unfälle mit Rollern oder Autos sind Alltag. Viele Hunde bleiben schwer verletzt oder gelähmt am Straßenrand zurück – ohne jede medizinische Hilfe, ohne dass jemand kommt.',
            solution: 'Mobile Tierarztteams, Rettung und Transport zu Tierkliniken, Rehabilitationsprogramme.',
          },
          {
            title: 'Gezielte Tötungen & Krankheiten',
            img: '/images/IMG_3554.jpg',
            desc: 'Dazu kommt die Gefahr durch Vergiftungen, wenn versucht wird, das „Straßenhundeproblem" auf grausame Weise zu lösen. Unbehandelte Wunden, Parasiten und Hautkrankheiten schwächen die Tiere täglich.',
            solution: 'Impf- und Entwurmungsprogramme, Behandlung von Hautkrankheiten, Aufklärung über humanen Tierschutz.',
          },
        ].map((item) => (
          <div class="card overflow-hidden">
            <div class="aspect-video overflow-hidden">
              <img src={item.img} alt={item.title} class="w-full h-full object-cover" loading="lazy" />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold mb-3">{item.title}</h3>
              <p class="text-white/60 text-sm leading-relaxed mb-4">{item.desc}</p>
              <div class="border-t border-white/5 pt-4">
                <p class="text-xs text-amber-500 uppercase tracking-wider mb-2 font-bold">Unsere Lösung</p>
                <p class="text-white/70 text-sm">{item.solution}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Zitat -->
  <section class="py-16 bg-forest">
    <div class="container-x text-center max-w-2xl mx-auto">
      <blockquote class="text-2xl md:text-3xl font-bold italic text-white/90 leading-relaxed">
        „Jeder Bissen zählt, um diesen Seelen Hoffnung zu geben."
      </blockquote>
      <p class="text-white/50 mt-4">Fynn &amp; Eileen</p>
    </div>
  </section>

  <!-- Die vier Säulen -->
  <section class="py-20 bg-gray-dark">
    <div class="container-x">
      <div class="text-center mb-14">
        <p class="eyebrow mb-3">Unser Ansatz</p>
        <h2 class="section-heading">Den Kreislauf<br /><span class="text-amber-500">durchbrechen.</span></h2>
        <p class="section-subheading mx-auto mt-4">Wir bekämpfen nicht nur die Symptome. Wir packen das Problem an der Wurzel.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {[
          {
            nr: '01',
            title: 'Kastrationen',
            desc: 'Nur durch flächendeckende Kastrationen stoppen wir das Leid, bevor es entsteht. Eine einzige unkastrierte Hündin kann in 6 Jahren durch unkontrollierte Vermehrung bis zu 60.000 Nachkommen verursachen.',
            img: '/images/IMG_2322.jpg',
            stat: '2.500+',
            statLabel: 'Kastrationen durchgeführt',
          },
          {
            nr: '02',
            title: 'Fütterungen',
            desc: 'Futter bedeutet Leben – und Vertrauen. Wir versorgen die Straßenhunde täglich mit nahrhaftem Futter und frischem Wasser. Diese Fütterungsrunden bewahren vor giftigem Müll und bauen das Vertrauen auf, das wir für medizinische Hilfe brauchen.',
            img: '/images/IMG_4737.jpg',
            stat: '3,7 Tonnen',
            statLabel: 'Futter verteilt',
          },
          {
            nr: '03',
            title: 'Medizinische Versorgung',
            desc: 'Schon kleine Verletzungen können ohne Hilfe tödlich enden. Jeder von uns kastrierte Hund erhält automatisch eine Parasitenbehandlung. Auf der Straße versorgen wir tiefe Wunden und stoppen lebensgefährlichen Madenbefall.',
            img: '/images/IMG_0991.jpg',
            stat: '100+',
            statLabel: 'Hunde monatlich operiert',
          },
          {
            nr: '04',
            title: 'Rettungen',
            desc: 'Wenn ein Hund angefahren, ausgesetzt oder in akuter Lebensgefahr ist, handeln wir sofort. Wir fokussieren uns auf den Süden Lomboks, holen Notfälle von der Straße und geben ihnen ein Zuhause auf Zeit.',
            img: '/images/IMG_2543.jpg',
            stat: '0 €',
            statLabel: 'Verwaltungskosten',
          },
        ].map((item) => (
          <div class="card overflow-hidden flex flex-col md:flex-row">
            <div class="md:w-48 shrink-0 overflow-hidden">
              <img src={item.img} alt={item.title} class="w-full h-48 md:h-full object-cover" loading="lazy" />
            </div>
            <div class="p-6 flex flex-col justify-between">
              <div>
                <p class="eyebrow mb-2">Säule {item.nr}</p>
                <h3 class="text-xl font-bold mb-3">{item.title}</h3>
                <p class="text-white/60 text-sm leading-relaxed">{item.desc}</p>
              </div>
              <div class="mt-4 border-t border-white/5 pt-4">
                <div class="stat-number text-3xl">{item.stat}</div>
                <div class="stat-label text-xs">{item.statLabel}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Straßenkatzen -->
  <section class="py-20 bg-black">
    <div class="container-x">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <p class="eyebrow mb-4">Auch sie brauchen uns</p>
          <h2 class="text-4xl font-black mb-4">Die Straßenkatzen –<br /><span class="text-amber-500">wir schauen nicht weg.</span></h2>
          <p class="prose-dark mb-4">
            Unser Hauptfokus liegt auf den Hunden, aber wir schauen nicht weg, wenn Katzen Hilfe brauchen. Sie werden von den Locals zwar eher toleriert, doch auch sie leiden massiv unter Krankheiten und Unterernährung.
          </p>
          <p class="prose-dark mb-6">
            In den letzten Monaten haben wir über 30 Katzen kastriert, medizinisch versorgt und ausgesetzte Babys aufgenommen – eine Samtpfote hat sogar schon ein Zuhause in Deutschland gefunden!
          </p>
          <a href="/projekte/" class="btn-ghost">Projekt Wing NGO Sumatra</a>
        </div>
        <div class="relative">
          <img
            src="/images/IMG_5371.jpg"
            alt="Straßenkatzen auf Lombok"
            class="rounded-2xl w-full aspect-[4/3] object-cover"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Vision -->
  <section class="py-20 bg-forest">
    <div class="container-x text-center max-w-3xl mx-auto">
      <p class="eyebrow mb-5">Unsere Vision</p>
      <h2 class="section-heading mb-6">Größer als<br />wir selbst.</h2>
      <p class="text-xl text-white/70 leading-relaxed mb-8">
        Wir träumen von einer Insel, auf der kein Welpe mehr auf der Straße geboren wird. Auf der kein Hund mehr leiden muss, nur weil niemand hingesehen hat.
      </p>
      <p class="text-white/60 mb-10">
        Um das Problem langfristig zu lösen, brauchen wir mobile Kliniken, mehr Kastrationsaktionen und starke Teams vor Ort. Das können wir nicht alleine stemmen. Jeder Rupiah, jede Spende und jede geteilte Geschichte macht diesen Traum realer.
      </p>
      <a href="/helfen/" class="btn-primary btn-large">Teil der Lösung werden</a>
    </div>
  </section>

  <!-- Kontakt -->
  <section class="py-20 bg-gray-dark">
    <div class="container-x max-w-2xl mx-auto">
      <ContactForm subject="Anfrage zu Mission / Projekt" />
    </div>
  </section>
</BaseLayout>

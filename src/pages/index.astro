---
import BaseLayout from '@/layouts/BaseLayout.astro';
import StatsBand from '@/components/StatsBand.astro';
import CTABand from '@/components/CTABand.astro';
import DogCard from '@/components/DogCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Lines from '@/components/Lines.astro';
import RichText from '@/components/RichText.astro';
import FaqSchema from '@/components/FaqSchema.astro';
import { SITE } from '@/data/site';
import { reader } from '@/lib/keystatic';
import { img } from '@/lib/img';

const dogEntries = await reader.collections.dogs.all();
const DOGS = dogEntries
  .filter(({ entry }) => entry.available)
  .map(({ slug, entry }) => ({ id: slug, ...entry }));
// Teaser zeigt 3 Hunde — Profile mit Foto zuerst, damit frisch angelegte
// Einträge ohne Bild die Startseite nicht anführen.
const TEASER_DOGS = [...DOGS]
  .sort((a, b) => Number(Boolean(b.image)) - Number(Boolean(a.image)))
  .slice(0, 3);

const projectEntries = await reader.collections.projects.all();
const TEASER_PROJECTS = projectEntries
  .map(({ slug, entry }) => ({ id: slug, ...entry }))
  .sort((a, b) => (a.nummer ?? 0) - (b.nummer ?? 0))
  .slice(0, 3);

const homeData = await reader.singletons.homeContent.read();

// Hero
const heroEyebrow = homeData?.heroEyebrow || 'Travel2Rescue e.V. · Kuta, Lombok';
const heroTitleTop = homeData?.heroTitleTop || '50.000';
const heroTitleAccent = homeData?.heroTitleAccent || 'Straßenhunde.';
const heroTitleBottom = homeData?.heroTitleBottom || 'Nur wir sehen hin.';
const heroSub = homeData?.heroSub || 'Jeden Tag kämpfen Hunde auf Lombok ums Überleben – hungrig, krank, allein.\nFynn & Eileen haben aufgehört wegzuschauen. Wir auch nicht mehr.';
const heroImage = img(homeData?.heroImage, '/images/new_hero.jpeg');

const trustItems = homeData?.trustItems?.length
  ? homeData.trustItems
  : ['e.V. seit 2023', 'Vereinsregister Hof', '100% Tierschutz', 'Steuerlich absetzbar'];

// Mission Teaser (Foto rechts — gespiegelt zur Über-uns-Sektion)
const missionEyebrow = homeData?.missionEyebrow || 'Unsere Mission';
const missionHeadline = homeData?.missionHeadline || 'Den Kreislauf aus Elend\ndurchbrechen.';
const missionBodyFallback = 'Schätzungsweise 50.000 Straßenhunde leben auf Lombok – krank, hungrig, völlig auf sich allein gestellt. Wir bekämpfen nicht nur die Symptome, wir packen das Problem an der Wurzel.\n\nKastrationen, Fütterungen, medizinische Versorgung und Rettungen: vier Säulen, ein Ziel – eine Insel, auf der kein Welpe mehr auf der Straße geboren wird.';
const missionImage = img(homeData?.missionImage, '/images/IMG_2977.jpg');

// Was wir tun — icons stay fixed, text editable
const SERVICE_ICONS = [
  '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z"/><path d="m12 5 1.6 1.6"/><path d="M22 16.92V19.5a2.5 2.5 0 0 1-2.5 2.5h-15A2.5 2.5 0 0 1 2 19.5v-2.58"/><path d="m6 14 4 4"/><path d="m14 14-4 4"/>',
  '<path d="M11 2v2"/><path d="M5 2v2"/><path d="M5 3H4a2 2 0 0 0-2 2v4a6 6 0 0 0 12 0V5a2 2 0 0 0-2-2h-1"/><path d="M8 15a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>',
  '<circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/>',
  '<path d="M17 10c.7-.7 1.69 0 2.5 0a2.5 2.5 0 1 0 0-5 .5.5 0 0 1-.5-.5 2.5 2.5 0 1 0-5 0c0 .81.7 1.8 0 2.5l-7 7c-.7.7-1.69 0-2.5 0a2.5 2.5 0 0 0 0 5c.28 0 .5.22.5.5a2.5 2.5 0 1 0 5 0c0-.81-.7-1.8 0-2.5Z"/>',
];
const defaultServices = [
  { title: 'Rettung', desc: 'Ausgesetzt, angefahren, dem Tod nah – wir nehmen uns den Hunden an, die ohne uns keine Chance hätten.' },
  { title: 'Medizinische Versorgung', desc: 'Operationen, Wundversorgung, Parasitenbehandlung – wir bezahlen die Not-OP, die über Leben und Tod entscheidet.' },
  { title: 'Kastration', desc: 'Eine unkastrierte Hündin kann in 6 Jahren bis zu 60.000 Nachkommen verursachen. Wir stoppen das Leid an der Wurzel.' },
  { title: 'Fütterung', desc: 'Täglich verteilen wir Futter. Nicht nur Nahrung – auch Vertrauen. Ohne Vertrauen kein Zugang, ohne Zugang keine Hilfe.' },
];
const servicesEyebrow = homeData?.servicesEyebrow || 'Was wir konkret tun';
const servicesHeadline = homeData?.servicesHeadline || 'Direkt helfen. Nachhaltig verändern.';
const servicesSource = homeData?.services?.length ? homeData.services : defaultServices;
const services = servicesSource.map((s, i) => ({ ...s, svg: SERVICE_ICONS[i] ?? SERVICE_ICONS[0] }));

// Projekte Teaser
const projectsEyebrow = homeData?.projectsEyebrow || 'Unsere Projekte';
const projectsHeadline = homeData?.projectsHeadline || 'Hier passiert die Arbeit.';
const projectsSub = homeData?.projectsSub || 'Konkrete Projekte, an denen echte Hilfe ankommt – auf Lombok und darüber hinaus.';

// Adoptions-Teaser (mit grossem Hintergrundfoto)
const dogsEyebrow = homeData?.dogsEyebrow || 'Zur Adoption freigegeben';
const dogsHeadline = homeData?.dogsHeadline || 'Sie warten auf dich.';
const dogsSub = homeData?.dogsSub || 'Jeder dieser Hunde hat überlebt. Jetzt brauchen sie ein letztes Kapitel: dein Zuhause.';
const dogsImage = img(homeData?.dogsImage, '/images/fynneileen dogs.jpeg');

// Über-uns Teaser
const storyEyebrow = homeData?.storyEyebrow || 'Unsere Geschichte';
const storyHeadline = homeData?.storyHeadline || 'Aus Mitleid wurde Verantwortung.';
const storyBodyFallback = 'Eigentlich wollten Fynn & Eileen nur reisen. Dann kam dieser eine Welpe – geschlagen, allein auf der Straße. Sie schauten sich an. Kein Wort. Und blieben.\n\nWas als Schüssel Futter vor der Tür begann, wurde zur Lebensaufgabe. Heute sind sie Gründer des gemeinnützigen Vereins Travel2Rescue e.V. und kämpfen jeden Tag für die Hunde, die sonst niemand sieht.';
const storyImage = img(homeData?.storyImage, '/images/fynn eileen walking.jpeg');
const storyPostcard = homeData?.storyPostcard || 'Lombok, März 2023 — der eine Welpe, der alles veränderte.';

const founderQuote = homeData?.founderQuote || 'Was wir hier tun, ist mehr als Tierschutz. Es ist eine Familie. Eine Bewegung. Eine Entscheidung: nicht wegzusehen.';

const faqEyebrow = homeData?.faqEyebrow || 'Häufige Fragen';
const faqHeadline = homeData?.faqHeadline || 'FAQ';
const faqs = homeData?.homeFaqs?.length
  ? homeData.homeFaqs
  : [
      { question: 'Kann ich mal vorbeikommen und die Hunde streicheln?', answer: 'Wir lieben Besuch, aber wir haben kein öffentliches Tierheim – wir pflegen die Hunde privat bei uns zu Hause und in Pflegestellen. Da wir nur zu zweit sind, können wir keinen Besuch empfangen. Unser Fokus liegt 24/7 auf der Versorgung der Notfälle.' },
      { question: 'Ich habe einen Hund gesehen, der Hilfe braucht – was tun?', answer: 'Schick uns ein Video und den genauen Standort per DM auf Instagram. Wir prüfen unsere Kapazitäten und vernetzen dich mit anderen Organisationen, falls wir nicht helfen können. Bitte hab Verständnis – wir sind voll bis unters Dach.' },
      { question: 'Wo genau geht mein Geld hin?', answer: 'Zu 100% in die Tierhilfe. Wir haben keine Verwaltungskosten. Dein Geld kauft Futter, bezahlt Kastrationen und begleicht die Tierarztrechnungen, die unser größter Kostenpunkt sind.' },
      { question: 'Wie funktioniert eine Adoption aus Indonesien?', answer: 'Möglich, aber ein Marathon. Aufgrund der Tollwut-Bestimmungen dauert die Ausreisevorbereitung mindestens 6–7 Monate (Titer-Test, Wartezeiten, Papiere). Wenn du diese Geduld mitbringst, begleiten wir dich durch den gesamten Prozess.' },
    ];
---

<BaseLayout
  title={SITE.name}
  description="50.000 Straßenhunde leben auf Lombok. Wir sind da. Travel2Rescue e.V. rettet, behandelt und vermittelt Straßenhunde – 100% transparent, 0% Verwaltungskosten."
>
  <!-- Hero -->
  <section class="relative min-h-[90vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={heroImage}
        alt="Eileen auf der Müllhaide auf Lombok – Travel2Rescue e.V."
        class="w-full h-full object-cover object-[40%_center]"
        width="1200"
        height="857"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/60 to-black/20" />
    </div>

    <div class="container-x relative z-10 py-20">
      <div class="max-w-2xl">
        <p class="eyebrow mb-5">{heroEyebrow}</p>
        <h1 class="text-5xl md:text-7xl font-black leading-[0.95] tracking-normal mb-6">
          {heroTitleTop}<br />
          <span class="text-amber-500">{heroTitleAccent}</span><br />
          {heroTitleBottom}
        </h1>
        <p class="text-lg md:text-xl text-white/70 leading-relaxed mb-8 max-w-lg">
          <Lines text={heroSub} />
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/helfen/" class="btn-primary btn-large">Jetzt helfen</a>
          <a href="/mission/" class="btn-ghost btn-large">Unsere Mission</a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30 animate-bounce">
      <span class="text-xs uppercase tracking-widest">Mehr erfahren</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- Trust Strip -->
  <section class="bg-amber-500/5 border-y border-amber-500/10">
    <div class="container-x py-4">
      <p class="text-center text-sm text-white/60 flex flex-wrap justify-center items-center gap-x-3 gap-y-1">
        {trustItems.map((item, i) => (
          <>
            {i > 0 && <span class="text-amber-500/40">·</span>}
            <span>{item}</span>
          </>
        ))}
      </p>
    </div>
  </section>

  <!-- Stats -->
  <StatsBand />

  <!--
    Die folgenden Sektionen spiegeln die Navigation in ihrer Reihenfolge:
    Unsere Mission → Projekte → Adoptieren → Helfen → Über uns.
    Jede Sektion verlinkt auf die zugehörige Unterseite.
  -->

  <!-- 1) Unsere Mission — Foto rechts (gespiegelt zur Über-uns-Sektion unten) -->
  <section class="py-20 bg-gray-dark overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-5 lg:col-start-2 container-x lg:px-0">
        <p class="eyebrow mb-4">{missionEyebrow}</p>
        <h2 class="section-heading mb-6">
          <Lines text={missionHeadline} />
        </h2>
        <RichText
          value={homeData?.missionBody}
          fallback={missionBodyFallback}
          class="prose-dark"
          leadClass="text-lg"
          lastSpacing="mb-8"
        />
        <a href="/mission/" class="btn-ghost">Unsere Mission</a>
      </div>

      <div class="lg:col-span-6 relative">
        <img
          src={missionImage}
          alt="Straßenhund auf Lombok"
          class="w-full aspect-[4/3] object-cover rounded-l-2xl"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Was wir tun — vertieft die Mission; 2x2 grid, Lucide outline icons -->
  <section class="relative py-20 bg-black overflow-hidden">
    <!-- Punkteraster wie auf der Adoptions-Timeline — Eileens Liebling -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.06]" style="background-image: radial-gradient(circle at 1px 1px, #E8D4BB 1px, transparent 0); background-size: 28px 28px;"></div>
    <div class="container-x relative">
      <div class="text-center mb-14">
        <p class="eyebrow mb-3">{servicesEyebrow}</p>
        <h2 class="section-heading"><Lines text={servicesHeadline} /></h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {services.map((item) => (
          <div class="rounded-2xl bg-amber-500/5 border border-amber-500/10 p-7 hover:bg-amber-500/10 transition-colors">
            <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mb-5 text-amber-500">
              <svg class="w-6 h-6 stroke-current" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={item.svg} />
            </div>
            <h3 class="text-xl font-bold mb-2">{item.title}</h3>
            <p class="text-white/65 text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2) Projekte Teaser -->
  <section class="py-20 bg-gray-dark">
    <div class="container-x">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">{projectsEyebrow}</p>
        <h2 class="section-heading"><Lines text={projectsHeadline} /></h2>
        <p class="section-subheading mx-auto mt-4">{projectsSub}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {TEASER_PROJECTS.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
      <div class="text-center">
        <a href="/projekte/" class="btn-primary btn-large">Alle Projekte ansehen</a>
      </div>
    </div>
  </section>

  <!-- 3) Adoptieren Teaser — grosses Hintergrundfoto, damit die Sektion nicht untergeht -->
  <section class="relative py-20 overflow-hidden">
    <div class="absolute inset-0">
      <img src={dogsImage} alt="" class="w-full h-full object-cover object-center" loading="lazy" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/90 via-black/75 to-black/90" />
    </div>
    <div class="container-x relative z-10">
      <div class="text-center mb-12">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-white/50 mb-3">
          Aktuell warten {DOGS.length} {DOGS.length === 1 ? 'Hund' : 'Hunde'} auf ein Zuhause
        </p>
        <p class="eyebrow mb-3">{dogsEyebrow}</p>
        <h2 class="section-heading">{dogsHeadline}</h2>
        <p class="section-subheading mx-auto mt-4">{dogsSub}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {TEASER_DOGS.map((dog) => (
          <DogCard dog={dog} />
        ))}
      </div>
      <div class="text-center">
        <a href="/adoptieren/" class="btn-primary btn-large">Alle {DOGS.length} Hunde ansehen</a>
      </div>
    </div>
  </section>

  <!-- 4) Helfen = die vertraute beige "Wir brauchen Deine Hilfe"-Band (CTABand
       ganz unten). Der separate Helfen-Teaser wurde auf Wunsch entfernt. -->

  <!-- 5) Über uns Teaser — asymmetric, photo bleeds to left edge -->
  <section class="py-20 bg-gray-dark overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-6 relative">
        <div class="relative">
          <img
            src={storyImage}
            alt="Fynn und Eileen auf Lombok"
            class="w-full aspect-[4/3] object-cover rounded-r-2xl"
            loading="lazy"
          />
          <!-- Postcard caption overlay -->
          <div class="absolute bottom-6 right-6 max-w-xs bg-cream text-black/80 px-5 py-4 shadow-2xl rotate-[-1.5deg]">
            <p class="font-serif italic text-base leading-snug">
              {storyPostcard}
            </p>
            <div class="mt-2 h-px w-10 bg-black/30" />
            <p class="mt-1 text-[10px] uppercase tracking-widest text-black/50">Fynn &amp; Eileen</p>
          </div>
          <!-- e.V. badge -->
          <div class="absolute top-6 right-6 bg-amber-500 text-black rounded-2xl p-3 text-center shadow-xl">
            <div class="text-2xl font-black leading-none">e.V.</div>
            <div class="text-[10px] font-bold uppercase mt-1">seit 2023</div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 container-x lg:px-0 lg:pr-8">
        <p class="eyebrow mb-4">{storyEyebrow}</p>
        <h2 class="section-heading mb-6">
          <Lines text={storyHeadline} />
        </h2>
        <RichText
          value={homeData?.storyBody}
          fallback={storyBodyFallback}
          class="prose-dark"
          leadClass="text-lg"
          lastSpacing="mb-8"
        />
        <a href="/ueber-uns/" class="btn-ghost">Unsere Geschichte</a>
      </div>
    </div>
  </section>

  <!-- Zitat — full-bleed photo backdrop -->
  <section class="relative py-28 md:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/fynn eileen dogs horizontal.jpg"
        alt=""
        class="w-full h-full object-cover object-center"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/75 to-black/85" />
    </div>
    <div class="container-x relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <svg class="w-12 h-12 mx-auto mb-8 text-amber-500/70" fill="currentColor" viewBox="0 0 24 24">
          <path d="M9.13 9.5c0 2.3 1.6 4.1 3.7 4.1.4 0 .8-.1 1.1-.2-1.3 2.3-3.5 3.6-3.5 3.6L11.83 19s7.3-3.9 7.3-11.5c0-2.8-1.9-4.7-4.5-4.7-2.8 0-5.5 2-5.5 6.7zM0 9.5c0 2.3 1.6 4.1 3.7 4.1.4 0 .8-.1 1.1-.2-1.3 2.3-3.5 3.6-3.5 3.6L2.7 19S10 15.1 10 7.5C10 4.7 8.1 2.8 5.5 2.8 2.7 2.8 0 4.8 0 9.5z" />
        </svg>
        <blockquote class="font-serif italic text-3xl md:text-5xl text-white leading-[1.25] mb-10">
          „{founderQuote}"
        </blockquote>
        <div class="flex items-center justify-center gap-4">
          <img
            src="/images/fynn eileen dogs horizontal.jpg"
            alt="Fynn & Eileen"
            class="w-12 h-12 rounded-full object-cover object-top border-2 border-amber-500/40"
            loading="lazy"
          />
          <div class="text-left">
            <div class="text-white font-semibold text-sm">Fynn &amp; Eileen</div>
            <div class="text-white/60 text-xs uppercase tracking-wider">Gründer, Travel2Rescue e.V.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ — single column, serif questions -->
  <section class="py-20 bg-black">
    <div class="container-x max-w-2xl mx-auto">
      <div class="text-center mb-12">
        <p class="eyebrow mb-3">{faqEyebrow}</p>
        <h2 class="section-heading">{faqHeadline}</h2>
      </div>
      <div class="divide-y divide-white/5 border-y border-white/5">
        {faqs.map((faq) => (
          <details class="group py-5">
            <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
              <h3 class="font-serif text-lg md:text-xl text-white leading-snug">
                {faq.question}
              </h3>
              <span class="shrink-0 mt-1 w-7 h-7 rounded-full border border-white/15 flex items-center justify-center text-white/60 group-open:bg-amber-500 group-open:text-black group-open:border-amber-500 transition-colors">
                <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <div class="mt-4 pr-11">
              <RichText value={faq.answer} class="text-white/70 leading-relaxed" spacing="mb-3" lastSpacing="mb-0" />
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTABand
    primary={{ label: 'Jetzt spenden', href: '/helfen/' }}
    secondary={{ label: 'Hund adoptieren', href: '/adoptieren/' }}
  />

  <FaqSchema faqs={faqs} />
</BaseLayout>

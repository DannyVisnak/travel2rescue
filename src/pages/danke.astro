---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/data/site';

const url = new URL(Astro.request.url);
const type = url.searchParams.get('typ') || 'kontakt';

const COPY = {
  kontakt: {
    eyebrow: 'Danke',
    title: 'Nachricht ist da.',
    accent: 'Wir lesen mit.',
    sub: 'Wir melden uns so schnell wie möglich bei dir – meistens innerhalb von 1–3 Tagen.',
  },
  adoption: {
    eyebrow: 'Danke',
    title: 'Anfrage angekommen.',
    accent: 'Eileen meldet sich.',
    sub: 'Eileen schaut sich dein Formular in Ruhe an und meldet sich per WhatsApp bei dir, sobald sie kann.',
  },
};

const copy = COPY[type as keyof typeof COPY] ?? COPY.kontakt;
---

<BaseLayout
  title="Danke"
  description="Deine Nachricht ist angekommen."
  noIndex={true}
>
  <section class="relative min-h-[80vh] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/fynn eileen dogs horizontal.jpg"
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/80 to-black/90" />
    </div>

    <div class="container-x relative z-10 text-center max-w-2xl mx-auto py-20">
      <span class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-amber-500 text-black mb-6 mx-auto">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <polyline points="20 6 9 17 4 12" />
        </svg>
      </span>
      <p class="eyebrow mb-5">{copy.eyebrow}</p>
      <h1 class="font-serif text-5xl md:text-7xl font-semibold leading-[1.05] tracking-tight mb-6">
        {copy.title}<br /><span class="text-amber-500 italic">{copy.accent}</span>
      </h1>
      <p class="text-lg text-white/70 leading-relaxed mb-10 max-w-lg mx-auto">
        {copy.sub}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/helfen/" class="btn-primary btn-large">Auch spenden?</a>
        <a href="/" class="btn-ghost btn-large">Zurück zur Startseite</a>
      </div>

      <p class="mt-12 text-sm text-white/40">
        Folg uns auf{' '}
        <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:text-amber-500 underline underline-offset-4">Instagram</a>
        {' '}für tägliche Updates aus Lombok.
      </p>
    </div>
  </section>
</BaseLayout>

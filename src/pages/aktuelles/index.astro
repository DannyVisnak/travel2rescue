---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CTABand from '@/components/CTABand.astro';
import { reader } from '@/lib/keystatic';
import { img } from '@/lib/img';

const entries = await reader.collections.news.all();
const posts = entries
  .map(({ slug, entry }) => ({ slug, ...entry }))
  .filter((p) => !p.draft)
  .sort((a, b) => (a.date && b.date ? b.date.localeCompare(a.date) : 0));

function formatDate(d?: string | null) {
  if (!d) return '';
  return new Date(d).toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' });
}
---

<BaseLayout
  title="Aktuelles"
  description="Neuigkeiten und Updates von Travel2Rescue e.V. aus Lombok – Rettungen, Projekte, Erfolge."
>
  <!-- Hero -->
  <section class="relative py-24 overflow-hidden">
    <div class="absolute inset-0">
      <img src="/images/IMG_4737.jpg" alt="" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-black/75" />
    </div>
    <div class="container-x relative z-10 text-center max-w-3xl mx-auto">
      <p class="eyebrow mb-5">Aktuelles</p>
      <h1 class="font-serif text-5xl md:text-6xl font-semibold leading-[1.05] tracking-tight mb-6">
        Neues von<br /><span class="text-amber-500 italic">der Insel.</span>
      </h1>
      <p class="text-xl text-white/70">
        Rettungen, Projekte, Erfolge – direkt aus Lombok.
      </p>
    </div>
  </section>

  <!-- Posts -->
  <section class="py-20 bg-black">
    <div class="container-x max-w-4xl mx-auto">
      {posts.length === 0 ? (
        <p class="text-center text-white/60">Aktuell keine Beiträge. Schau bald wieder vorbei.</p>
      ) : (
        <div class="grid grid-cols-1 gap-10">
          {posts.map((post) => (
            <article class="card overflow-hidden grid grid-cols-1 md:grid-cols-[1fr_2fr]">
              {post.image ? (
                <a href={`/aktuelles/${post.slug}/`} class="block aspect-[4/3] md:aspect-auto overflow-hidden">
                  <img src={img(post.image)} alt={post.title} class="w-full h-full object-cover" loading="lazy" />
                </a>
              ) : (
                <div class="hidden md:block bg-gray-mid" />
              )}
              <div class="p-6 md:p-8 flex flex-col">
                <p class="eyebrow mb-3">{formatDate(post.date)}</p>
                <h2 class="text-2xl md:text-3xl font-black mb-3">
                  <a href={`/aktuelles/${post.slug}/`} class="hover:text-amber-400 transition-colors">{post.title}</a>
                </h2>
                {post.excerpt && (
                  <p class="text-white/70 leading-relaxed mb-5">{post.excerpt}</p>
                )}
                <a href={`/aktuelles/${post.slug}/`} class="mt-auto inline-flex items-center gap-2 text-amber-400 hover:text-amber-500 text-sm font-semibold">
                  Weiterlesen
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                    <path d="M5 12h14M13 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  <CTABand />
</BaseLayout>

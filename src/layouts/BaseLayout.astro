---
import { SITE } from '@/data/site';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
// StickyDonation is owned by another agent. Import is left in place — if the
// file does not exist yet, the build will warn but rendering will fail soft.
import StickyDonation from '@/components/StickyDonation.astro';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.og.image,
  ogType = 'website',
  noIndex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const ogImageURL = ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`;
// Only the default share card has known 1200×630 dimensions. Custom images
// (e.g. a dog's portrait) leave dims off so scrapers infer the real ratio.
const isDefaultOg = ogImage === SITE.og.image;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: SITE.name,
  url: SITE.url,
  logo: `${SITE.url}/logo.avif`,
  image: `${SITE.url}/og-image.png`,
  description: SITE.description,
  email: SITE.email,
  telephone: SITE.phone,
  foundingDate: '2023',
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    postalCode: SITE.address.zip,
    addressCountry: 'DE',
  },
  sameAs: [SITE.social.instagram, SITE.social.facebook, SITE.social.tiktok],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: 'de-DE',
};

// Breadcrumbs derived from the URL path so every page gets structured nav
// without the page having to pass anything.
const BREADCRUMB_LABELS: Record<string, string> = {
  mission: 'Unsere Mission',
  projekte: 'Projekte',
  adoptieren: 'Adoptieren',
  formular: 'Adoptionsformular',
  helfen: 'Helfen',
  'ueber-uns': 'Über uns',
  linktree: 'Linktree',
  impressum: 'Impressum',
  datenschutz: 'Datenschutz',
};
// Privacy-friendly analytics: only render the Plausible script if the user
// configured PUBLIC_PLAUSIBLE_DOMAIN. Plausible doesn't use cookies and is
// GDPR-friendly (no banner required). Self-hosted instances override via
// PUBLIC_PLAUSIBLE_SRC.
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleSrc =
  import.meta.env.PUBLIC_PLAUSIBLE_SRC || 'https://plausible.io/js/script.js';

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbJsonLd = segments.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${SITE.url}/` },
        ...segments.map((seg, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name:
            BREADCRUMB_LABELS[seg] ??
            seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()),
          item: `${SITE.url}/${segments.slice(0, i + 1).join('/')}/`,
        })),
      ],
    }
  : null;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    {isDefaultOg && <meta property="og:image:width" content={String(SITE.og.width)} />}
    {isDefaultOg && <meta property="og:image:height" content={String(SITE.og.height)} />}
    <meta property="og:image:alt" content={`${SITE.name} – Tierschutz auf Lombok`} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={`${SITE.name} – Tierschutz auf Lombok`} />

    <meta name="theme-color" content="#0D0D0D" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://rsms.me" crossorigin />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700,800,900&display=swap" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}

    {plausibleDomain && (
      <script defer data-domain={plausibleDomain} src={plausibleSrc}></script>
    )}
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-amber-500 focus:text-black focus:font-bold focus:rounded-lg">
      Zum Hauptinhalt springen
    </a>
    <Header />
    <main id="main-content" class="pt-16">
      <slot />
    </main>
    <Footer />
    <StickyDonation />
  </body>
</html>

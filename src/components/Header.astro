---
import { SITE, NAV, NAV_CTA } from '@/data/site';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-black/90 backdrop-blur-md border-b border-white/5">
  <div class="container-x">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 shrink-0">
        <img src="/logo.avif" alt={SITE.name} class="h-8 w-auto" loading="eager" />
      </a>

      <nav class="hidden md:flex items-center gap-6">
        {NAV.map((item) => (
          <a
            href={item.href}
            class="text-sm text-white/70 hover:text-white transition-colors font-medium"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a href={NAV_CTA.href} class="btn-primary text-xs px-4 py-2">
          {NAV_CTA.label}
        </a>
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 text-white/70 hover:text-white"
          aria-label="Menü öffnen"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-white/5 bg-black">
    <div class="container-x py-4 flex flex-col gap-3">
      {NAV.map((item) => (
        <a href={item.href} class="text-sm text-white/70 hover:text-white py-2 font-medium">
          {item.label}
        </a>
      ))}
      <a href={NAV_CTA.href} class="btn-primary text-center mt-2">
        {NAV_CTA.label}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>

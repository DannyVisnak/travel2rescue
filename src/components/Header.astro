---
import { SITE, NAV, NAV_CTA } from '@/data/site';
import { reader } from '@/lib/keystatic';

const cmsSettings = await reader.singletons.settings.read();
const ctaHref = cmsSettings?.paypalUrl || NAV_CTA.href;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-black/90 backdrop-blur-md border-b border-white/5">
  <div class="container-x">
    <div class="flex items-center justify-between h-20">
      <a href="/" class="flex items-center shrink-0 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 focus:ring-offset-black rounded" aria-label={SITE.name}>
        <span class="font-display font-extrabold text-2xl md:text-3xl tracking-tight text-amber-500 lowercase leading-none">travel2rescue</span>
      </a>

      <nav aria-label="Hauptnavigation" class="hidden md:flex items-center gap-6">
        {NAV.map((item) => (
          <a
            href={item.href}
            class="text-sm text-white/70 hover:text-white transition-colors font-medium focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 focus:ring-offset-black rounded"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a href={ctaHref} target="_blank" rel="noopener noreferrer" class="btn-primary text-xs px-4 py-2">
          {NAV_CTA.label}
        </a>
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 text-white/70 hover:text-white focus:outline-none focus:ring-2 focus:ring-amber-500 rounded"
          aria-label="Menü öffnen"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Disclosure-Pattern (aria-expanded am Button), KEIN Dialog: role="dialog"
       ohne Fokus-Trap/aria-modal wäre für Screenreader irreführend -->
  <nav id="mobile-menu" class="hidden md:hidden border-t border-white/5 bg-black" aria-label="Mobilmenü">
    <div class="container-x py-4 flex flex-col gap-3">
      {NAV.map((item) => (
        <a href={item.href} class="text-sm text-white/70 hover:text-white py-2 font-medium focus:outline-none focus:text-amber-400">
          {item.label}
        </a>
      ))}
      <a href={ctaHref} class="btn-primary text-center mt-2">
        {NAV_CTA.label}
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    function setOpen(open: boolean) {
      menu!.classList.toggle('hidden', !open);
      btn!.setAttribute('aria-expanded', String(open));
      btn!.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    }
    btn.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });
    // Close the panel when the user activates a link inside it. Without this,
    // hash-only navigations (#kontakt etc.) leave the overlay covering the
    // section the user just jumped to.
    menu.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a')) setOpen(false);
    });
    // Esc closes the menu — and returns focus to the toggle button so
    // keyboard/screen-reader users don't strand on <body>.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        btn.focus();
      }
    });
  }
</script>

---
import { SITE } from '@/data/site';
import { reader } from '@/lib/keystatic';

interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats?: Stat[];
}

const cms = await reader.singletons.settings.read();
// 3 Kennzahlen (nicht 4) — Wunsch von Fynn & Eileen
const defaultStats: Stat[] = [
  { value: cms?.statsKastrationen || SITE.stats.kastrationen, label: 'Kastrationen' },
  { value: cms?.statsFutter || SITE.stats.futter, label: 'Futter verteilt' },
  { value: cms?.statsOperiert || SITE.stats.operiert, label: 'Hunde monatlich operiert' },
];

const { stats = defaultStats } = Astro.props;
---

<div class="bg-black border-y border-white/5 py-12">
  <div class="container-x">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
      {stats.map((s) => (
        <div>
          <div class="stat-number">{s.value}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</div>

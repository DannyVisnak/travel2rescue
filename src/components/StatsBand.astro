---
import { SITE } from '@/data/site';

interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats?: Stat[];
}

const defaultStats: Stat[] = [
  { value: SITE.stats.kastrationen, label: 'Kastrationen' },
  { value: SITE.stats.futter, label: 'Futter verteilt' },
  { value: SITE.stats.operiert, label: 'Hunde monatlich operiert' },
  { value: '0 €', label: 'Verwaltungskosten' },
];

const { stats = defaultStats } = Astro.props;
---

<div class="bg-black border-y border-white/5 py-12">
  <div class="container-x">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {stats.map((s) => (
        <div>
          <div class="stat-number">{s.value}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</div>

---
// Startseite → „Was wir tun". Die Symbole sind fest an die Position gebunden
// (SERVICE_ICONS in index.astro) — Text ändern behält das passende Symbol.
import Lines from '@/components/Lines.astro';

interface Props {
  eyebrow: string;
  headline: string;
  services: ReadonlyArray<{ title: string; desc: string; svg: string }>;
}
const { eyebrow, headline, services } = Astro.props;
---

<section class="relative py-20 bg-black overflow-hidden">
  <!-- Punkteraster wie auf der Adoptions-Timeline — Eileens Liebling -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.06]" style="background-image: radial-gradient(circle at 1px 1px, #E8D4BB 1px, transparent 0); background-size: 28px 28px;"></div>
  <div class="container-x relative">
    <div class="text-center mb-14">
      <p class="eyebrow mb-3">{eyebrow}</p>
      <h2 class="section-heading"><Lines text={headline} /></h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
      {services.map((item) => (
        <div class="rounded-2xl bg-amber-500/5 border border-amber-500/10 p-7 hover:bg-amber-500/10 transition-colors">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mb-5 text-amber-500">
            <svg class="w-6 h-6 stroke-current" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" set:html={item.svg} />
          </div>
          <h3 class="text-xl font-bold mb-2">{item.title}</h3>
          <p class="text-white/65 text-sm leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

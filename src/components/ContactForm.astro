---
interface Props {
  subject?: string;
}
const { subject = 'Anfrage über travel2rescue.de' } = Astro.props;

// When the no-JS form path POSTs to /api/contact and the API fails, it
// 303-redirects back here with ?error=1. Show that inline so the user
// isn't left wondering.
const showError = Astro.url.searchParams.get('error') === '1';
---

<div class="card p-8 md:p-10">
  <h3 class="text-2xl font-bold mb-6">Hast du Fragen oder möchtest du helfen?</h3>
  <form
    id="contact-form"
    method="POST"
    action="/api/contact"
    class="space-y-4"
  >
    <input type="hidden" name="subject" value={subject} />
    <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" />

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="vorname" class="form-label">Vorname *</label>
        <input type="text" id="vorname" name="vorname" required placeholder="Max" class="input-field" />
      </div>
      <div>
        <label for="nachname" class="form-label">Nachname</label>
        <input type="text" id="nachname" name="nachname" placeholder="Mustermann" class="input-field" />
      </div>
    </div>

    <div>
      <label for="email" class="form-label">E-Mail *</label>
      <input type="email" id="email" name="email" required placeholder="deine@email.de" class="input-field" />
    </div>

    <div>
      <label for="telefon" class="form-label">Telefon (optional)</label>
      <input type="tel" id="telefon" name="telefon" placeholder="+49 123 456789" class="input-field" />
    </div>

    <div>
      <label for="betreff" class="form-label">Worum geht es?</label>
      <select id="betreff" name="betreff" class="input-field">
        <option value="">Bitte wählen...</option>
        <option value="spenden">Ich möchte spenden</option>
        <option value="adoption">Ich interessiere mich für eine Adoption</option>
        <option value="volunteer">Ich möchte Volunteer werden</option>
        <option value="presse">Presse / Kooperation</option>
        <option value="sonstiges">Sonstiges</option>
      </select>
    </div>

    <div>
      <label for="nachricht" class="form-label">Nachricht *</label>
      <textarea
        id="nachricht"
        name="nachricht"
        required
        rows="4"
        placeholder="Schreib uns, was dir am Herzen liegt..."
        class="input-field resize-none"
      ></textarea>
    </div>

    <button type="submit" class="btn-primary w-full justify-center py-4 text-base">
      Nachricht senden
    </button>

    <p
      id="form-result"
      class={`text-center text-sm pt-2 ${showError ? 'text-red-400' : 'hidden'}`}
      role="alert"
      aria-live="polite"
    >
      {showError ? 'Etwas hat nicht funktioniert. Schreib uns direkt: travel2rescue@gmail.com' : ''}
    </p>
  </form>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const result = document.getElementById('form-result');

  // If the no-JS fallback redirected here with ?error=1, show the message
  // even when the page itself is prerendered (so Astro.url couldn't see it).
  if (result && new URLSearchParams(window.location.search).get('error') === '1') {
    result.textContent = 'Etwas hat nicht funktioniert. Schreib uns direkt: travel2rescue@gmail.com';
    result.classList.remove('hidden');
    result.classList.add('text-red-400');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!result) return;

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.dataset.original = btn.textContent || '';
      btn.textContent = 'Wird gesendet...';
    }

    const data = new FormData(form);
    let ok = false;
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        body: data,
        headers: { accept: 'application/json' },
      });
      const json = await res.json();
      ok = res.ok && json.ok === true;
    } catch {
      ok = false;
    }

    result.classList.remove('hidden', 'text-red-400', 'text-green-400');
    if (ok) {
      (window.dataLayer = window.dataLayer || []).push({
        event: 'contact_form_submit',
        form_subject: String(data.get('subject') || ''),
        page_path: location.pathname,
      });
      result.textContent = 'Danke! Wir melden uns so schnell wie möglich bei dir.';
      result.classList.add('text-green-400');
      form.reset();
      if (btn) btn.textContent = 'Gesendet ✓';
    } else {
      result.textContent = 'Etwas hat nicht funktioniert. Schreib uns direkt: travel2rescue@gmail.com';
      result.classList.add('text-red-400');
      if (btn) {
        btn.disabled = false;
        btn.textContent = btn.dataset.original || 'Nachricht senden';
      }
    }
    result.classList.remove('hidden');
  });
</script>

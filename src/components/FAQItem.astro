---
import RichText from '@/components/RichText.astro';
import type { RichTextValue } from '@/lib/richtext';

interface Props {
  question: string;
  /** Aus dem CMS eine Absatz-Liste, im Fallback ein einfacher String. */
  answer: RichTextValue;
}
const { question, answer } = Astro.props;
---

<details class="group border-b border-white/5 py-5">
  <summary class="flex items-center justify-between cursor-pointer list-none gap-4">
    <span class="text-base font-semibold text-white group-open:text-amber-400 transition-colors">{question}</span>
    <span class="shrink-0 w-6 h-6 rounded-full bg-white/5 group-open:bg-amber-500/20 flex items-center justify-center transition-colors">
      <svg class="w-3 h-3 text-white/50 group-open:rotate-45 group-open:text-amber-400 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
    </span>
  </summary>
  <div class="mt-4 pr-10">
    <RichText
      value={answer}
      class="text-white/60 text-sm leading-relaxed"
      spacing="mb-3"
      lastSpacing="mb-0"
    />
  </div>
</details>

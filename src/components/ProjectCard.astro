---
import type { Project } from '@/data/projects';
import { img } from '@/lib/img';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card group overflow-hidden">
  <div class="relative aspect-[16/9] overflow-hidden">
    <img
      src={img(project.image)}
      alt={project.title}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" />
    <div class="absolute bottom-4 left-4">
      <span class="eyebrow">Projekt {project.nummer}</span>
    </div>
    <div class="absolute top-4 right-4">
      <span class="pill bg-amber-500/20 text-amber-400 border border-amber-500/30">
        {project.status === 'aktiv' ? '● Aktiv' : project.status}
      </span>
    </div>
  </div>
  <div class="p-6">
    <!-- min-h reserviert 2 Zeilen für Titel/Untertitel, damit die Beschreibungen
         nebeneinanderliegender Karten auf gleicher Höhe beginnen -->
    <h3 class="text-xl font-bold mb-1 md:min-h-14">{project.title}</h3>
    <p class="text-amber-500 text-sm font-medium mb-3 md:min-h-10">{project.subtitle}</p>
    <p class="text-white/60 text-sm leading-relaxed">{project.description}</p>
  </div>
</article>

---
import type { Dog } from '@/data/dogs';
import { img } from '@/lib/img';
import { richTextToPlain } from '@/lib/richtext';
import { imageFocusClass } from '@/lib/layout';

interface Props {
  dog: Dog;
}

const { dog } = Astro.props;

// Auf der Karte steht nur ein Anreisser (line-clamp-3) — die Absatz-Struktur
// der Geschichte wird hier bewusst zu einer Zeile eingeebnet.
const storyTeaser = richTextToPlain(dog.story).replace(/\s+/g, ' ').trim();
---

<article class="card group overflow-hidden flex flex-col">
  <div class="relative aspect-[4/3] overflow-hidden shrink-0">
    <img
      src={img(dog.image, '/images/fynneileen dogs.jpeg')}
      alt={`${dog.name} – zur Adoption`}
      class:list={['w-full h-full object-cover group-hover:scale-105 transition-transform duration-500', imageFocusClass(dog.imageFocus, '')]}
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent" />
    {dog.tag && (
      <div class="absolute top-3 left-3">
        <span class="pill bg-amber-500 text-black text-xs font-bold">{dog.tag}</span>
      </div>
    )}
  </div>
  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-start justify-between mb-2">
      <div>
        <h3 class="text-xl font-bold">{dog.name}</h3>
        <p class="text-white/50 text-sm">{[dog.age, dog.geschlecht, dog.breed].filter(Boolean).join(' · ')}</p>
      </div>
      <span class="text-xs text-amber-400 font-semibold uppercase tracking-wide mt-1">{dog.character}</span>
    </div>
    <p class="text-white/60 text-sm leading-relaxed line-clamp-3">{storyTeaser}</p>
    <!-- mt-auto pinnt die Buttons an den Kartenboden — so liegen sie in jeder
         Reihe auf gleicher Höhe, egal wie der Text darüber umbricht -->
    <div class="mt-auto pt-4">
      <!-- Direkt zum Adoptionsformular — Hund wird per ?hund= vorausgewählt,
           #adoption-form scrollt zum Formular -->
      <a
        href={`/adoptieren/formular/?hund=${dog.id}#adoption-form`}
        class="btn-primary w-full justify-center py-2.5 text-xs"
      >
        Adoptionsanfrage stellen
      </a>
      <a
        href={`/adoptieren/${dog.id}/`}
        class="mt-2 inline-flex w-full items-center justify-center rounded-full border border-amber-500/40 text-amber-400 hover:border-amber-400 hover:bg-amber-500/10 transition-colors py-2.5 text-xs font-semibold uppercase tracking-wider"
      >
        Mehr über {dog.name}
      </a>
    </div>
  </div>
</article>

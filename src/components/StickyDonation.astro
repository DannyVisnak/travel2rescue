---
// Persistent floating donation CTA. Renders as a fixed bottom-right pill on
// every page EXCEPT pages that already foreground their own donation/CTA
// (/helfen, /patenschaft, /danke), and admin/utility pages (/keystatic,
// /linktree, /404).
import { SITE } from '@/data/site';
import { reader } from '@/lib/keystatic';

const cms = await reader.singletons.settings.read();
const paypalUrl = cms?.paypalUrl ?? SITE.social.paypal;

const pathname = Astro.url.pathname;
const HIDE_PREFIXES = ['/helfen', '/patenschaft', '/danke', '/keystatic', '/linktree', '/404'];
const hide = HIDE_PREFIXES.some((p) => pathname.startsWith(p));
---

{!hide && (
  <a
    href={paypalUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Jetzt spenden"
    class="group fixed bottom-5 right-5 sm:bottom-6 sm:right-6 z-40 inline-flex items-center gap-2 rounded-full bg-amber-500 hover:bg-amber-400 text-black font-semibold pl-4 pr-5 py-3 text-sm shadow-lg shadow-amber-500/30 hover:shadow-xl hover:shadow-amber-500/40 transition-all duration-200 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:ring-offset-2 focus:ring-offset-black"
    style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-5 h-5 stroke-current transition-transform duration-200 group-hover:scale-110"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z" />
    </svg>
    <span>Jetzt spenden</span>
  </a>
)}

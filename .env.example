# travel2rescue — environment variables reference.
# Copy this file to .env.local for local dev (Keystatic still uses the local
# filesystem there, so only Resend + Plausible are relevant locally).
#
# In production these all live in Vercel → Project → Settings → Environment.

# ─── Keystatic CMS (required in production) ─────────────────────────────────
# See CLAUDE.md → "GitHub App (NOT a classic OAuth App)" for setup.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
# Generate with: openssl rand -base64 32
KEYSTATIC_SECRET=

# ─── Resend (required for the contact + adoption forms) ─────────────────────
# Get a key at https://resend.com; verify travel2rescue.de as a sending domain.
RESEND_API_KEY=
# Optional overrides:
# RESEND_FROM=Travel2Rescue <kontakt@travel2rescue.de>
# RESEND_TO=travel2rescue@gmail.com

# ─── Plausible analytics (optional, privacy-friendly) ───────────────────────
# When set, BaseLayout emits the Plausible <script> in <head>.
# PUBLIC_PLAUSIBLE_DOMAIN=travel2rescue.de
# Self-hosted instances can override the script URL:
# PUBLIC_PLAUSIBLE_SRC=https://analytics.example.com/js/script.js

# ─── Sitewide password lock (under-construction mode) ───────────────────────
# When set, src/middleware.ts requires HTTP Basic Auth on every request
# (any username, this exact password) before the public site is reachable.
# The CMS admin (/keystatic/*), its OAuth callbacks (/api/keystatic/*), the
# health endpoint, and .well-known/* remain accessible. Unset to unlock.
# SITE_PASSWORD=

